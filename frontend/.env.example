# Server-side base URL of the Django API.
API_BASE_URL=http://127.0.0.1:8000/api/v1
# Public base URL used by the browser (image srcs, client fetches).
# Must share a site with the app for the admin console's SameSite=Lax refresh
# cookie to travel: use `localhost`, never `127.0.0.1`.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the /api/revalidate webhook called by the backend.
REVALIDATE_SECRET=change-me
